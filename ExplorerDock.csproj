<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExplorerDock</RootNamespace>
    <AssemblyName>ExplorerDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <Product>ExplorerDock</Product>
    <AssemblyTitle>ExplorerDock</AssemblyTitle>
    <Description>把文件资源管理器窗口从任务栏解放到悬浮栏</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- UseWindowsForms 会隐式 global using System.Drawing / System.Windows.Forms，
       它们和 WPF 的 Brush/Image/MenuItem 等类型重名，这里移除，需要的文件里显式 using。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
