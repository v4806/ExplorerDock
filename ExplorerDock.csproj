<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExplorerDock</RootNamespace>
    <AssemblyName>ExplorerDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.8</Version>
    <Product>ExplorerDock</Product>
    <AssemblyTitle>ExplorerDock</AssemblyTitle>
    <Description>把文件资源管理器窗口从任务栏解放到悬浮栏</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- UseWindowsForms 会隐式 global using System.Drawing / System.Windows.Forms，
       它们和 WPF 的 Brush/Image/MenuItem 等类型重名，这里移除，需要的文件里显式 using。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!--
    这里本来有一段"publish 后剔除用不到的运行时文件"的处理，用来压安装包体积（49.5MB → 37MB）。
    已经删掉了：删 PresentationFramework.Fluent.dll 会让 WPF 的默认控件模板加载失败
    （打开「贴边隐藏设置」直接抛 XamlParseException），而这类文件看着没用、实际可能是
    某个控件的模板/类型转换器依赖。体积大一点没关系，功能别出幺蛾子。
  -->

</Project>






























































